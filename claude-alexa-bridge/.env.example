# Anthropic API Configuration
ANTHROPIC_API_KEY=your_api_key_here

# Server Configuration
PORT=3000
HOST=0.0.0.0

# Claude Configuration
CLAUDE_MODEL=claude-3-5-sonnet-20241022
SYSTEM_PROMPT=You are Claude, an AI assistant. You're being accessed through an Alexa device. Keep responses concise and natural for voice output, typically under 50 words unless asked for more detail.

# Mode Configuration (start in Claude mode)
DEFAULT_MODE=claude

# Logging
DEBUG=false
LOG_LEVEL=info
